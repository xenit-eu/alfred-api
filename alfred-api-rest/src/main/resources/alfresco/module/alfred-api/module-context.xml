<?xml version='1.0' encoding='UTF-8'?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
            http://www.springframework.org/schema/context
            https://www.springframework.org/schema/context/spring-context.xsd">
    <bean class="eu.xenit.alfred.api.rest.SpringConfig"/>

    <!--
        Register native Alfresco Web Scripts throughout the REST module.
        Restrict component scanning to AbstractWebScript implementations
        to avoid registering unrelated Spring components.
     -->
    <context:component-scan
            base-package="eu.xenit.alfred.api.rest"
            use-default-filters="false">

        <context:include-filter
                type="assignable"
                expression="org.springframework.extensions.webscripts.AbstractWebScript"/>

    </context:component-scan>

</beans>